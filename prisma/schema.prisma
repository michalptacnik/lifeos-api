generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROCESS
  DONE
}

enum TaskArea {
  HOME
  BUDGET
  WORK
}

enum InventorySubtype {
  HOME
  WORK
  FOOD
}

enum MatrixMembershipState {
  JOINED
  INVITED
  LEFT
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  displayName  String?
  googleSub    String?       @unique
  appleSub     String?       @unique
  passwordHash String?
  createdAt    DateTime      @default(now())
  memberships  Membership[]
  tasks        Task[]        @relation("TaskOwner")
  audits       AuditLog[]
  workSessions WorkSession[]
  matrixIdentity MatrixIdentity?
  matrixRoomMemberships MatrixRoomMembership[]
}

model Household {
  id          String          @id @default(cuid())
  name        String
  createdAt   DateTime        @default(now())
  memberships Membership[]
  tasks       Task[]
  accounts    Account[]
  inventory   InventoryItem[]
  recipes     Recipe[]
  matrixRooms MatrixRoom[]
  obligations Obligation[]
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  householdId String
  role        Role
  user        User      @relation(fields: [userId], references: [id])
  household   Household @relation(fields: [householdId], references: [id])

  @@unique([userId, householdId])
}

model Task {
  id              String        @id @default(cuid())
  householdId     String
  ownerUserId     String?
  title           String
  description     String?
  area            TaskArea      @default(WORK)
  project         String?
  dueAt           DateTime?
  recurrenceRrule String?
  status          TaskStatus    @default(TODO)
  startedOn       DateTime?
  finishedOn      DateTime?
  createdAt       DateTime      @default(now())
  completedAt     DateTime?
  household       Household     @relation(fields: [householdId], references: [id])
  owner           User?         @relation("TaskOwner", fields: [ownerUserId], references: [id])
  workSessions    WorkSession[]
}

model WorkSession {
  id        String   @id @default(cuid())
  userId    String
  taskId    String
  startedAt DateTime
  endedAt   DateTime?
  notes     String   @default("")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  task      Task     @relation(fields: [taskId], references: [id])

  @@index([userId, endedAt])
  @@index([taskId, startedAt])
}

model Account {
  id          String         @id @default(cuid())
  householdId String
  name        String
  currency    String         @default("EUR")
  createdAt   DateTime       @default(now())
  household   Household      @relation(fields: [householdId], references: [id])
  entries     CashflowEntry[]
}

model CashflowEntry {
  id         String   @id @default(cuid())
  accountId  String
  amount     Decimal
  direction  String
  category   String?
  occurredAt DateTime
  recurring  Boolean  @default(false)
  account    Account  @relation(fields: [accountId], references: [id])
}

model InventoryItem {
  id            String           @id @default(cuid())
  householdId   String
  name          String
  subtype       InventorySubtype @default(HOME)
  quantity      Decimal          @default(1)
  unit          String           @default("item")
  category      String?
  location      String?
  expiresAt     DateTime?
  acquiredAt    DateTime?
  currentValue  Decimal?
  warrantyUntil DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  household     Household        @relation(fields: [householdId], references: [id])

  @@index([householdId, subtype])
}

model Recipe {
  id          String             @id @default(cuid())
  householdId String
  name        String
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  household   Household          @relation(fields: [householdId], references: [id])
  ingredients RecipeIngredient[]

  @@index([householdId, name])
}

model RecipeIngredient {
  id        String   @id @default(cuid())
  recipeId  String
  name      String
  quantity  Decimal  @default(1)
  unit      String   @default("item")
  createdAt DateTime @default(now())
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId, name])
}

model Obligation {
  id          String    @id @default(cuid())
  householdId String
  type        String
  title       String
  dueAt       DateTime
  reminderAt  DateTime?
  status      String    @default("active")
  household   Household @relation(fields: [householdId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  payload     Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id])
}

model MatrixIdentity {
  id           String   @id @default(cuid())
  userId       String   @unique
  matrixUserId String   @unique
  displayName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

model MatrixRoom {
  id              String                 @id @default(cuid())
  householdId     String
  externalRoomId  String
  alias           String?
  name            String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  household       Household              @relation(fields: [householdId], references: [id])
  memberships     MatrixRoomMembership[]
  relayEvents     MatrixRelayEvent[]

  @@unique([householdId, externalRoomId])
  @@index([householdId, name])
}

model MatrixRoomMembership {
  id                String                @id @default(cuid())
  roomId            String
  userId            String
  membership        MatrixMembershipState @default(JOINED)
  unreadCount       Int                   @default(0)
  notificationCount Int                   @default(0)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  room              MatrixRoom            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user              User                  @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@index([userId, membership])
}

model MatrixRelayEvent {
  id                String   @id @default(cuid())
  roomId            String
  externalEventId   String
  eventType         String
  senderMatrixUserId String?
  payload           Json?
  createdAt         DateTime @default(now())
  room              MatrixRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, externalEventId])
  @@index([roomId, createdAt])
}
